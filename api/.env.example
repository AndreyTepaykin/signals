# Copy to .env and set your local Postgres password (# must be URL-encoded as %23)
DATABASE_URL=postgresql+asyncpg://signals:YOUR_PASSWORD_HERE@127.0.0.1:5432/signals
# Dev (ng serve): http://localhost:4200
# Local nginx (prod-like): https://signals.loc
CORS_ORIGINS=http://localhost:4200,https://signals.loc,http://signals.loc
